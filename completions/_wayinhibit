#compdef wayinhibit

_wayinhibit() {
    _arguments -s -S \
        '(-t --timeout)'{-t,--timeout}'[stop after a given duration]:duration (e.g. 30s\, 5m\, 2h)' \
        '(-q --quiet)'{-q,--quiet}'[suppress informational output (warnings and errors remain)]' \
        '(-p --pid-file)'{-p,--pid-file}'[write PID to PATH on startup and lock it, remove it on exit]:pid file:_files' \
        '--on-inhibit[run CMD (via sh -c) when inhibition starts]:command (sh -c)' \
        '--on-release[run CMD (via sh -c) when inhibition stops]:command (sh -c)' \
        '--dry-run[run without connecting to Wayland]' \
        '--toggle[stop the running instance from --pid-file, or start one]' \
        '(-h --help)'{-h,--help}'[print help]' \
        '(-V --version)'{-V,--version}'[print version]'
}

_wayinhibit "$@"
