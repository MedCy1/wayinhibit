)
source_aarch64=(
    "$pkgname-$pkgver::https://github.com/MedCy1/wayinhibit/releases/download/v$pkgver/wayinhibit-aarch64"
)
sha256sums=(
    'e63e1bf780ae1e754957bbfde93a35761cc0013470d43a674f15f5ac76d75325'
)
